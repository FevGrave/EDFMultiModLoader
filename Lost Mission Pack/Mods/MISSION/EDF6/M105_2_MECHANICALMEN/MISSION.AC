void __0003_game_event()
{
	if( IsBoolState(3,::__0003_data.m_is_break,::__0003_data.m_is_break) ) return;
	
	::__0003_data.m_counter++;
	if( ::__0003_data.m_counter != 1 ) return;
	if( internal_BeginFinishing() == false ) return; // 終了処理が開始済みなら帰る
	Mutex_LockObject@ __internal_thread_lock = ::__0003_data.m_mutex.Lock();
	internal_InitEventThread(3, ::__0003_data.m_counter, "__0003_game_event", "終了");
	
	WaitVoice();
	g_soldiers = GetTalkers();
	::__0003_data.m_game_thread_sync.Reset();
	::__0003_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0003_voice_event");

	__0003_game_event_usercode();
	
	::__0003_data.m_game_thread_sync.Update(__END_SYNC);
	::__0003_data.m_voice_thread_sync.Wait(__END_SYNC);
	while(true) sys_Yield();
}

