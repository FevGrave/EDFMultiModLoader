			0,	// 内部ジェネレータ番号
			"app:/object/e618_squid_small.sgo",	// 発生させるオブジェクトの sgo ファイルパス
			6,	// 発生数
			1.0,	// レベル
			10,	// １体毎の発生間隔
			5,	// 次回の集団発生までの間隔
			true	// 遭遇状態で作成する？
		);

	{
		internal_EventFactorRegister@ e = internal_CreateEvent("__001A_game_event", "ジェネレータDの敵強化", 1.00, EVENT_TYPE_ASYNC, EVENT_CHECK_AND, 1); // ジェネレータDの敵強化
		// [e2d_section_data] {"GUID":"4521782f-94d5-47a7-9bd3-f2ad83f8cbbd","Name":"Link from [フェーズ4 キャリア増援]","Type":"Link"}
		e.Factor_AiMoveEnd(carrierD08);
	}

	{
		internal_EventFactorRegister@ e = internal_CreateEvent("__0016_game_event", "終了", 100000000.00, EVENT_TYPE_SYNC, EVENT_CHECK_AND, 1); // 終了
		// [e2d_section_data] {"GUID":"1dfdb0a0-2df3-40d5-9cbf-403c8cfaca63","Name":"Link from [フェーズ4 キャリア増援]","Type":"Link"}
		e.Factor_AllEnemyDestroy(1.0);
	}
