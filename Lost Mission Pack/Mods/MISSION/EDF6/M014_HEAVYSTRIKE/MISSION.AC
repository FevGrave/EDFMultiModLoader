//======================================
// 裸軍団増援
void __0001_game_event()
{
	if( IsBoolState(1,::__0001_data.m_is_break,::__0001_data.m_is_break) ) return;
	
	::__0001_data.m_counter++;
	if( ::__0001_data.m_counter != 1 ) return;
	Mutex_LockObject@ __internal_thread_lock = ::__0001_data.m_mutex.Lock();
	internal_InitEventThread(1, ::__0001_data.m_counter, "__0001_game_event", "裸軍団増援");
	
	WaitVoice();
	g_soldiers = GetTalkers();
	::__0001_data.m_game_thread_sync.Reset();
	::__0001_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0001_voice_event");

	__0001_game_event_usercode();
	
	::__0001_data.m_game_thread_sync.Update(__END_SYNC);
	::__0001_data.m_voice_thread_sync.Wait(__END_SYNC);
}

void __0001_game_event_usercode()
{
	// [e2d_section_data] {"GUID":"716c812a-6176-48d2-a7cc-8bdf667c64df","Name":"裸軍団増援","Type":"game_script"}
	if( IsBoolState(1,::__0001_data.m_is_pass,::__0001_data.m_is_pass) == false){
		// ゲーム進行スクリプト


		int count = 2;
		if( GetDifficulty() >=MISSION_DIFFICULTY_HARDEST ) count = 3;

		CreateNeutral(
			"敵2_01",	// エリア名
			"app:/object/e512_dropboat.sgo",	// sgo ファイルパス
			1
		).DropBoat_SetAutoCruise(
			"敵2_01投下" /*降下ポイント*/,
			1 /*降下開始距離*/
		).DropBoat_SetCrew(
			"app:/object/E503_ARMORFROG_SG_LEADER.sgo",	// リーダー
			1,	// リーダーレベル
			"app:/object/E503_ARMORFROG_AF.sgo",	// 部下
			count,	// 部下数
			1,	// 部下レベル
			true	// 遭遇状態？
		);

		CreateFlyingEnemyGroup_Area(
			"UFO1",	// エリア名
			"app:/object/E507_GOLDUFO.sgo",	// sgo ファイルパス
			30,	// 作成数
			1,	// レベル（標準：1）
			true	// true に設定すると遭遇状態
		);

		CreateNeutral(
			"敵2_02",	// エリア名
			"app:/object/e512_dropboat.sgo",	// sgo ファイルパス
			1
		).DropBoat_SetAutoCruise(
			"敵2_02投下" /*降下ポイント*/,
			1 /*降下開始距離*/
		).DropBoat_SetCrew(
			"app:/object/E503_ARMORFROG_LC_LEADER.sgo",	// リーダー
			1,	// リーダーレベル
			"app:/object/E503_ARMORFROG_SG.sgo",	// 部下
			count,	// 部下数
			1,	// 部下レベル
			true	// 遭遇状態？
		);

		CreateFlyingEnemyGroup_Area(
			"UFO2",	// エリア名
			"app:/object/E605_SPINNERUFO.sgo",	// sgo ファイルパス
			15,	// 作成数
			1,	// レベル（標準：1）
			true	// true に設定すると遭遇状態
		);

		CreateNeutral(
			"敵2_03",	// エリア名
			"app:/object/e512_dropboat.sgo",	// sgo ファイルパス
			1
		).DropBoat_SetAutoCruise(
			"敵2_03投下" /*降下ポイント*/,
			1 /*降下開始距離*/
		).DropBoat_SetCrew(
			"app:/object/E503_ARMORFROG_AF_LEADER.sgo",	// リーダー
			1,	// リーダーレベル
			"app:/object/E503_ARMORFROG_LC.sgo",	// 部下
			count,	// 部下数
			1,	// 部下レベル
			true	// 遭遇状態？
		);

		CreateFlyingEnemyGroup_Area(
			"UFO3",	// エリア名
			"app:/object/E605_SPINNERUFO_BLUE.sgo",	// sgo ファイルパス
