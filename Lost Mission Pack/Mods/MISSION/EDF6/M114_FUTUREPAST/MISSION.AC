void Main_usercode()
{
	// [e2d_section_data] {"GUID":"d8cb777a-eff9-4565-9b26-52c2f8217690","Name":"開始","Type":"game_script"}
	if( IsBoolState(0,::__0000_data.m_is_pass,::__0000_data.m_is_pass) == false){

		Map("app:/map/nw_jyousuicity.mac" /*マップファイルパス*/, "cloudy2" /*天候名*/);//暗闇ミッション専用天候。cloudyの環境マップのみを夜のテクスチャに入れ替えてある。

		SetWeaponCondition(WEAPON_CONDITION_FORCE_ENABLE /*環境*/);

	{
		internal_EventFactorRegister@ e = internal_CreateEvent("TIMELINE_GOOD", "ディロイ増援01", 1.00, EVENT_TYPE_SYNC, EVENT_CHECK_AND, 1); // ディロイ増援01
		e.Factor_Wait(0.0);
	}

		CreatePlayer("GOOD_PLAYER");

	}
	::__0000_data.m_game_thread_sync.Update(__END_SYNC);
	::__0000_data.m_voice_thread_sync.Wait(__END_SYNC);

}

