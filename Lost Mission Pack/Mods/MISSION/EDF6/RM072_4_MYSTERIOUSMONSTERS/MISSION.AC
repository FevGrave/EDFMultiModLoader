void Main_usercode()
{
	// [e2d_section_data] {"GUID":"23f8b4d6-6c22-431b-9b38-6099a961529f","Name":"開始","Type":"game_script"}
	if( IsBoolState(0,::__0000_data.m_is_pass,::__0000_data.m_is_pass) == false){
		//Map("app:/Map/nw_Seiyu_night.mac", "night" );
		Map("app:/Map/nw_Seiyu.mac", "evening" );
		SetWeaponCondition( WEAPON_CONDITION_FORCE_ENABLE );

		CreatePlayer("プレイヤー");

		{
			soldier01 = CreateFriend("兵士01", "app:/object/AiArmySoldier_sn.sgo", 1, FALSE );
			FixObjectAiPosition(soldier01, true );
			soldier02 = CreateFriend("兵士02", "app:/object/AiArmySoldier_sn.sgo", 1, FALSE );
			FixObjectAiPosition(soldier02, true );
			soldier03 = CreateFriend("兵士03", "app:/object/AiArmySoldier_sn.sgo", 1, FALSE );
			FixObjectAiPosition(soldier03, true );
			soldier04 = CreateFriend("兵士04", "app:/object/AiArmySoldier_sn.sgo", 1, FALSE );
			FixObjectAiPosition(soldier04, true );
			soldier05 = CreateFriend("兵士05", "app:/object/AiArmySoldier_sn.sgo", 1, FALSE );
			FixObjectAiPosition(soldier05, true );
		}

		{
		float friend_level = 2;
		CreateSergentSquad(
			"小隊01",	// 配置ポイント
			10,	// 配置半径
			friend_level,	// レベル
			false	// プレイヤーに合流する？
			);
		spriggan = CreateFriendSquad("小隊02", 10.0f,
									"app:/Object/AiPaleWing_elite_LR_Leader.sgo",
									"app:/Object/AiPaleWing_elite_Lance.sgo",
									1, friend_level, FALSE );

		grimreaper = CreateFriendSquad("小隊03", 10.0f,
									"app:/Object/AiHeavyArmor_SP_Leader.sgo",
									"app:/Object/AiHeavyArmor_SP.sgo",
									2, friend_level, FALSE );
		SetObjectAutoResurrection( g_sergent, true );
		SetObjectAutoResurrection( spriggan, true );
		SetObjectAutoResurrection( grimreaper, true );
		}

		monster = CreateEnemy("怪獣", "app:/object/e504_monsterA.sgo", 1, FALSE );
		SetIgnoreDamageEventMode( monster, true);

		Bgm("BGM_E5M10_Daikaiju");//大怪獣

		DisableAiRandomTalk(); // 全体のAI会話を禁止
	}
	// -----------------
	::__0000_data.m_game_thread_sync.Update(__END_SYNC);
	::__0000_data.m_voice_thread_sync.Wait(__END_SYNC);
