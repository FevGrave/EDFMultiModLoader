		internal_EventFactorRegister@ e = internal_CreateEvent("__0001_game_event", "怪獣移動、バラム登場", 0.00, EVENT_TYPE_SYNC, EVENT_CHECK_AND, 0); // 怪獣移動、バラム登場
		// [e2d_section_data] {"GUID":"c253de3b-4dbe-488a-a397-872de2b1721a","Name":"Link from [開始]","Type":"Link"}
	}
