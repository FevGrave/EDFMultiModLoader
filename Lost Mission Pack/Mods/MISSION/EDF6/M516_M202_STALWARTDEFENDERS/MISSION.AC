	// [e2d_section_data] {"GUID":"f88ccf6f-f640-4ef5-ad67-07a95d5f1582","Name":"乗移動終了&特定エリアについたら乗り物進行","Type":"game_script"}
	if( IsBoolState(14,::__000E_data.m_is_pass,::__000E_data.m_is_pass) == false){
		// ゲーム進行スクリプト

		nix01.SetAiRoute("戦車01Eルート" /*ルート名*/);
		nix02.SetAiRoute("戦車02Eルート" /*ルート名*/);
		tank01.SetAiRoute("戦車03Eルート" /*ルート名*/);
		tank02.SetAiRoute("戦車04Eルート" /*ルート名*/);

		{
			internal_EventFactorRegister@ e = internal_CreateEvent("GROUNDROBO", "ディロイ増援01", 1.00, EVENT_TYPE_SYNC, EVENT_CHECK_AND, 1); // ディロイ増援01
			e.Factor_Wait(30.0);
		}
	}
}

void GROUNDROBO()
{
		{
