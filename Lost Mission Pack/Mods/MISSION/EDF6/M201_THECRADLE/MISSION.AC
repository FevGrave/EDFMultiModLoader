void __0009_game_event()
{
	if( IsBoolState(9,::__0009_data.m_is_break,::__0009_data.m_is_break) ) return;
	
	::__0009_data.m_counter++;
	if( ::__0009_data.m_counter != 1 ) return;
	if( internal_BeginFinishing() == false ) return; // 終了処理が開始済みなら帰る
	Mutex_LockObject@ __internal_thread_lock = ::__0009_data.m_mutex.Lock();
	internal_InitEventThread(9, ::__0009_data.m_counter, "__0009_game_event", "終了");
	
	WaitVoice();
	g_soldiers = GetTalkers();
	::__0009_data.m_game_thread_sync.Reset();
	::__0009_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0009_voice_event");

	__0009_game_event_usercode();
	
	::__0009_data.m_game_thread_sync.Update(__END_SYNC);
	::__0009_data.m_voice_thread_sync.Wait(__END_SYNC);
	while(true) sys_Yield();
}

void __0009_game_event_usercode()
{
	// [e2d_section_data] {"GUID":"e53437b5-76ab-49d0-b2bf-a98a9b3bb1ff","Name":"終了","Type":"game_script"}
