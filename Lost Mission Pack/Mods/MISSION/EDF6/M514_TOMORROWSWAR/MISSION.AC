void __0016_game_event()
{
	if( IsBoolState(22,::__0016_data.m_is_break,::__0016_data.m_is_break) ) return;
	
	::__0016_data.m_counter++;
	if( ::__0016_data.m_counter != 1 ) return;
	if( internal_BeginFinishing() == false ) return; // 終了処理が開始済みなら帰る
	Mutex_LockObject@ __internal_thread_lock = ::__0016_data.m_mutex.Lock();
	internal_InitEventThread(22, ::__0016_data.m_counter, "__0016_game_event", "終了");
	
	WaitVoice();
	g_soldiers = GetTalkers();
	::__0016_data.m_game_thread_sync.Reset();
	::__0016_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0016_voice_event");

	__0016_game_event_usercode();
	
	::__0016_data.m_game_thread_sync.Update(__END_SYNC);
	::__0016_data.m_voice_thread_sync.Wait(__END_SYNC);
	while(true) sys_Yield();
}

