		Speak_Radio("DLC_BE016_010",0.0 );

		Wait(3);

		CreateFriend("卵嚢1_105" , "app:/object/ev608_icbm_landing.sgo", 1.0f, FALSE );

		Wait(1);

		CreateFriend("卵嚢1_106" , "app:/object/ev608_icbm_landing.sgo", 1.0f, FALSE );

		Wait(1);

		CreateFriend("卵嚢1_107" , "app:/object/ev608_icbm_landing.sgo", 1.0f, FALSE );

		Wait(1);

		CreateFriend("卵嚢1_108" , "app:/object/ev608_icbm_landing.sgo", 1.0f, FALSE );

		Wait(1);

		CreateFriend("卵嚢1_109" , "app:/object/ev608_icbm_landing.sgo", 1.0f, FALSE );

		Wait(10);

		float time = 1;
		EventLightTool light_tool;

		light_tool.EnvFadeAnimation(
			EVENT_LIGHT_ENV_FADE_FOG_COLOR,
			2,	// x(r)
			2,	// y(g)
			2,	// z(b)
			1,	// w(a)
			time
		);
		light_tool.EnvFadeAnimation(
			EVENT_LIGHT_ENV_FADE_FOG_BG_APPLY,
			1,	// x(r)
			0,	// y(g)
			0,	// z(b)
			1,	// w(a)
			time
		);
		light_tool.EnvFadeAnimation(
			EVENT_LIGHT_ENV_FADE_FOG_DISTANCE,
			-10,	// x(r)
			0,	// y(g)
			0,	// z(b)
			1,	// w(a)
			time-3
		);

		{
			internal_EventFactorRegister@ e = internal_CreateEvent("__0005_game_event", "ジェネレーター稼働2", 1.00, EVENT_TYPE_SYNC, EVENT_CHECK_AND, 1); // ジェネレーター稼働2
			e.Factor_Wait(2.0f);
		}

