void Main()
{
	if( IsBoolState(0,::__0000_data.m_is_break,::__0000_data.m_is_break) ) return;
	
	::__0000_data.m_counter++;
	const uint32 MAX_EVENT_ID = 5;
	internal_Initialize(MAX_EVENT_ID);
	internal_GetEventState(0).SetName("開始");
	internal_GetEventState(1).SetName("ダメージでのジェネレーター稼働");
	internal_GetEventState(2).SetName("ジェネレーター稼働1");
	internal_GetEventState(3).SetName("ジェネレーター稼働2");
	internal_GetEventState(4).SetName("ジェネレーター稼働3");
	internal_GetEventState(5).SetName("終了");
	
	Mutex_LockObject@ __internal_thread_lock = ::__0000_data.m_mutex.Lock();
	internal_InitEventThread(0, ::__0000_data.m_counter, "Main", "開始");
	
	// --------------------- pre loading begin.
	BeginLoading();
	PreloadMap("app:/map/nw_DLCmap602.mac", "cloudy", -1);
	Preload("app:/ui/UiResourceGroup_InMission.sgo", -1);
	Preload("app:/ui/UiResourceGroup_MissionCleared.sgo", -1);
	Preload("app:/ui/UiResourceGroup_MissionFailed.sgo", -1);
	Preload("app:/object/AIHEAVYARMOR_SP_LEADER.sgo", -1);
	Preload("app:/object/AIHEAVYARMOR_SP.sgo", -1);
	Preload("app:/object/AIARMYSOLDIER_S_OMG_SRANGE_LEADER.sgo", -1);
	Preload("app:/object/AiArmySoldier_SG.sgo", -1);
	Preload("app:/object/AIPALEWING_ELITE_LANCE_LEADER.sgo", -1);
	Preload("app:/object/AIPALEWING_ELITE_LR.sgo", -1);
	Preload("app:/object/e663_spider_egg_sac_large.sgo", -1);
	Preload("app:/object/e663_spider_egg_sac.sgo", -1);
	Preload("app:/object/e663_spider_egg_sac_small.sgo", -1);
	Preload("app:/object/e667_spider_medium.sgo", -1);
	Preload("app:/object/e651_spider01.sgo", -1);
	Preload("app:/object/GIANTSPIDER01.sgo", -1);
	Preload("app:/object/NEPHILA.sgo", -1);
	Preload("app:/object/V504_BEGARUTA_G_AI.sgo", -1);
	Preload("app:/object/V504_BEGARUTA_AI.sgo", -1);
	Preload("app:/object/e613_capsule.sgo", -1);
	Preload("app:/object/E503_FROG_AF.sgo", -1);
	Preload("app:/object/E506_NUDE_BIGGREY_AF.sgo", -1);
	Preload("app:/object/E601_MARTIAN_N.sgo", -1);
	Preload("app:/object/ev608_icbm_landing.sgo", -1);
	PreloadPlayerResource();
	WaitPreload();
	Online_WaitStart();
	EndLoading();
	// --------------------- pre loading end.

	WaitVoice();
	g_soldiers = GetTalkers();
	::__0000_data.m_game_thread_sync.Reset();
	::__0000_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0000_voice_event");

	Main_usercode();
	
	::__0000_data.m_game_thread_sync.Update(__END_SYNC);
	::__0000_data.m_voice_thread_sync.Wait(__END_SYNC);
}

