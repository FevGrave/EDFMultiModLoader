// 終了
void __000E_game_event()
{
	if( IsBoolState(14,::__000E_data.m_is_break,::__000E_data.m_is_break) ) return;
	
	::__000E_data.m_counter++;
	if( ::__000E_data.m_counter != 1 ) return;
	if( internal_BeginFinishing() == false ) return; // 終了処理が開始済みなら帰る
	Mutex_LockObject@ __internal_thread_lock = ::__000E_data.m_mutex.Lock();
	internal_InitEventThread(14, ::__000E_data.m_counter, "__000E_game_event", "終了");
	
	WaitVoice();
	g_soldiers = GetTalkers();
	::__000E_data.m_game_thread_sync.Reset();
	::__000E_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__000E_voice_event");

	__000E_game_event_usercode();
	
	::__000E_data.m_game_thread_sync.Update(__END_SYNC);
	::__000E_data.m_voice_thread_sync.Wait(__END_SYNC);
	while(true) sys_Yield();
}

