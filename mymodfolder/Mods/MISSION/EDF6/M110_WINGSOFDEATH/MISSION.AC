//蜂の巣から出てくる敵のセットアップ
//HornetNestSetUp(該当するObject,出現させる敵のsgoパス,敵数,出現間隔,次の集団発生までの間隔);
void HornetNestSetUp(Object object,string path,int count,float interval,float next_interval)
{
	object.SetEnemyGenerator(
		0,	// 内部ジェネレータ番号
		path,	// 発生させるオブジェクトの sgo ファイルパス
		count,	// 発生数
		1,	// レベル
		interval,	// １体毎の発生間隔
		next_interval,	// 次回の集団発生までの間隔
		false	// 遭遇状態で作成する？
	);
}

