void __0002_game_event_usercode()
{
	// [e2d_section_data] {"GUID":"90b7618e-1325-44a5-b32b-f113a9874c72","Name":"空爆1回目、正面からプレイヤー側に向かって爆撃","Type":"game_script"}
	if( IsBoolState(2,::__0002_data.m_is_pass,::__0002_data.m_is_pass) == false){
		// ゲーム進行スクリプト

		float interval = 3;

		PointAirStrike("砲撃1_01", EDF6_cannon_radius, "app:/object/DemoIndirectFireE25.sgo", 1.0f, EDF6_cannon_count, cannon_interval );
		Wait(interval);
		PointAirStrike("砲撃1_02", EDF6_cannon_radius, "app:/object/DemoIndirectFireE25.sgo", 1.0f, EDF6_cannon_count, cannon_interval );
		Wait(interval);
