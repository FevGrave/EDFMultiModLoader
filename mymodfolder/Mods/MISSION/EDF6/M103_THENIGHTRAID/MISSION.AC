	// [e2d_section_data] {"GUID":"ac8268e8-8ebc-4b47-a9ea-bb8507ed5e72","Name":"戦車隊砲撃開始","Type":"game_script"}
	if( IsBoolState(1,::__0001_data.m_is_pass,::__0001_data.m_is_pass) == false){
