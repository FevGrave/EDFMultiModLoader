void Main()
{
	if( IsBoolState(0,::__0000_data.m_is_break,::__0000_data.m_is_break) ) return;
	
	::__0000_data.m_counter++;
	const uint32 MAX_EVENT_ID = 10;
	internal_Initialize(MAX_EVENT_ID);
	internal_GetEventState(0).SetName("開始");
	internal_GetEventState(1).SetName("戦車隊砲撃開始");
	internal_GetEventState(2).SetName("空爆1回目、正面からプレイヤー側に向かって爆撃");
	internal_GetEventState(3).SetName("wave2");
	internal_GetEventState(4).SetName("空爆2回目、敵を横薙ぎに空爆");
	internal_GetEventState(5).SetName("wave3");
	internal_GetEventState(6).SetName("空爆3回目");
	internal_GetEventState(7).SetName("wave4");
	internal_GetEventState(8).SetName("終了");
	internal_GetEventState(9).SetName("空爆4回目");
	internal_GetEventState(10).SetName("同じ軌道で空爆追加(敵が強めなので)");
	
	Mutex_LockObject@ __internal_thread_lock = ::__0000_data.m_mutex.Lock();
	internal_InitEventThread(0, ::__0000_data.m_counter, "Main", "開始");
	
	// --------------------- pre loading begin.
	BeginLoading();
	PreloadMap("app:/map/nw_Seiyu_night.mac", "night", -1);
	Preload("app:/ui/UiResourceGroup_InMission.sgo", -1);
	Preload("app:/ui/UiResourceGroup_MissionCleared.sgo", -1);
	Preload("app:/ui/UiResourceGroup_MissionFailed.sgo", -1);
	Preload("app:/object/AiHeavyArmor_SMC_Leader.sgo", -1);
	Preload("app:/object/AiHeavyArmor_SMC.sgo", -1);
	Preload("app:/object/AiArmySoldier_SN_Leader.sgo", -1);
	Preload("app:/object/AiArmySoldier_SN.sgo", -1);
	Preload("app:/object/AiArmySoldier_AF_Leader.sgo", -1);
	Preload("app:/object/AiArmySoldier_AF.sgo", -1);
	Preload("app:/object/AiPaleWing_IZN_Leader.sgo", -1);
	Preload("app:/object/AiPaleWing_IZN.sgo", -1);
	Preload("app:/object/v603_flak_ai.sgo", -1);
	Preload("app:/object/v601_tank_ai.sgo", -1);
	Preload("app:/object/e602_berserker.sgo", -1);
	Preload("app:/object/DemoIndirectFireE25.sgo", -1);
	Preload("app:/object/e602_berserker_bommer.sgo", -1);
	Preload("app:/object/e602_berserker_middle_bommer.sgo", -1);
	Preload("app:/object/DemoAirStrikeE25_10.sgo", -1);
	Preload("app:/object/e602_berserker_grapple.sgo", -1);
	Preload("app:/object/e602_berserker_large_punch.sgo", -1);
	Preload("app:/object/e602_berserker_middle_punch.sgo", -1);
	PreloadPlayerResource();
	WaitPreload();
	Online_WaitStart();
	EndLoading();
	// --------------------- pre loading end.

	WaitVoice();
	g_soldiers = GetTalkers();
	::__0000_data.m_game_thread_sync.Reset();
	::__0000_data.m_voice_thread_sync.Reset();
	::internal_CreateThread("__0000_voice_event");

	Main_usercode();
	
	::__0000_data.m_game_thread_sync.Update(__END_SYNC);
	::__0000_data.m_voice_thread_sync.Wait(__END_SYNC);
}

